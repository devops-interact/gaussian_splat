# Copy to `.env` or `.env.local` for local dev. Vite only exposes variables prefixed with VITE_.

# Backend API origin (no trailing slash). Leave unset to use same-origin `/api/...` (e.g. with Vercel rewrites).
# VITE_API_BASE_URL=https://your-pod-id-8000.proxy.runpod.net

# ---------------------------------------------------------------------------
# Optional: GaussianSplats3D legacy worker path (CPU splat sort, no shared worker memory)
# ---------------------------------------------------------------------------
# Use if the viewer hangs on "Loading Gaussian Splats…" (GPU sort / workers + COEP).
#
# Name (exactly):
#   VITE_GS3D_FORCE_LEGACY_WORKERS
# Value (either works):
#   true
#   1
#
# Local: add to `.env` or `.env.local` in this `frontend/` folder, then restart `npm run dev`.
# Vercel: Project → Settings → Environment Variables → Production → Add:
#   Name:  VITE_GS3D_FORCE_LEGACY_WORKERS
#   Value: true
# Then redeploy (Vite bakes env at build time).
#
# VITE_GS3D_FORCE_LEGACY_WORKERS=true

# ---------------------------------------------------------------------------
# Optional: uniform viewer scene scale (splat mesh + camera + pick range)
# ---------------------------------------------------------------------------
# Makes the reconstruction appear larger in world units and widens orbit zoom limits.
# Clamped to 0.25–10. Rebuild/restart after change.
#
# VITE_VIEWER_SCENE_SCALE=2
