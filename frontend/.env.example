# Copy to `.env` or `.env.local` for local dev. Vite only exposes variables prefixed with VITE_.

# Leave unset in production — Railway frontend nginx proxies /api to BACKEND_URL.
# For local dev against a remote API, set explicitly:
# VITE_API_BASE_URL=https://your-api.up.railway.app

# Optional: uniform viewer scene scale (mesh + camera + pick range)
# VITE_VIEWER_SCENE_SCALE=2
